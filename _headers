# Force HTML revalidation so each deploy is served fresh (no manual cache purge).
# Images, icons and other static assets keep their normal caching.
/fr
  Cache-Control: no-cache

/en
  Cache-Control: no-cache

/de
  Cache-Control: no-cache

/it
  Cache-Control: no-cache

/es
  Cache-Control: no-cache

/pt
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

# Pages rebond auth (confirm.html / reset-password.html, 2026-07-25).
# Leur URL porte un code d'authentification a usage unique, donc :
#   - no-store (plus strict que le no-cache des pages legales) : aucune
#     copie de la reponse ni chez le CDN ni dans le cache du navigateur ;
#   - X-Robots-Tag : double le <meta name="robots"> pour les crawlers qui
#     ne lisent pas le HTML ;
#   - Referrer-Policy : double le <meta name="referrer">, le code ne doit
#     fuir dans aucun Referer sortant.
# Le motif * couvre la forme sans extension (/confirm, servie par le
# html_handling de Cloudflare) et la forme /confirm.html.
/confirm*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/reset-password*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

# Universal Links / App Links (2026-07-27). Ces deux fichiers doivent sortir en
# JSON et SANS redirection : ni iOS ni Android ne suivent une redirection pour
# les recuperer. Le no-cache evite qu'une version fautive reste collee au CDN
# pendant qu'on la corrige.
/.well-known/*
  Content-Type: application/json
  Cache-Control: no-cache

/apple-app-site-association
  Content-Type: application/json
  Cache-Control: no-cache
